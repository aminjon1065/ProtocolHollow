# Unreal generated / per-machine
Binaries/
Intermediate/
Saved/
DerivedDataCache/
Plugins/**/Binaries/
Plugins/**/Intermediate/

# Packaged builds (Build/Scripts/package-win64.ps1)
Packages/

# IDE / project files (regenerated by UnrealBuildTool)
.vs/
.vscode/
.idea/
*.sln
*.xcworkspace
*.xcodeproj
*.code-workspace
*.VC.db
*.VC.opendb
*.opensdf
*.sdf
*.suo
compile_commands.json

# Python bytecode of the content scripts' shared modules (Build/Python/hollow_loc.py, LOC-01)
__pycache__/
*.pyc

# OS
.DS_Store
Thumbs.db
Desktop.ini

# Placeholder content copied from the local UE 5.8 templates (Build/Scripts/import-placeholders.*, ADR-0011)
Content/Characters/Mannequins/
Content/FirstPerson/

# Packaging by-products (S4-06): file-open-order logs, the package version counter, the engine's default Mac entitlements
# (the project signs with Build/Mac/Resources/Hollow.entitlements, ADR-0024)
Build/*/FileOpenOrder/
*.PackageVersionCounter
Build/Mac/Resources/Sandbox.*.entitlements
