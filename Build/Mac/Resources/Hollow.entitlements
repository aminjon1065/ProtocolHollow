<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Protocol: Hollow on macOS (S4-06, ADR-0024): no App Sandbox, so the game reaches the Steam client, the network and its
     own Saved folder in every configuration. Hardened runtime and notarisation (a Developer ID) are not set up yet.
     S4-07: audio input for proximity voice; required once the hardened runtime is on, harmless before. -->
<plist version="1.0">
<dict>
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
