#. Key:	Class.Engineer.Description
#. SourceLocation:	/Game/Hollow/Localization/ST_World.ST_World
#: /Game/Hollow/Localization/ST_World.ST_World
msgctxt "ST_World,Class.Engineer.Description"
msgid "Cuts, welds and mines the squad's way through the wreck. Tools run hotter before they overheat; heavier plating."
msgstr "Режет, варит и минирует отряду путь сквозь обломки. Инструменты дольше греются до перегрева; броня тяжелее."

#. Key:	Class.Engineer.Name
#. SourceLocation:	/Game/Hollow/Localization/ST_World.ST_World
#: /Game/Hollow/Localization/ST_World.ST_World
msgctxt "ST_World,Class.Engineer.Name"
msgid "Engineer"
msgstr "Инженер"

#. Key:	Class.Occultist.Description
#. SourceLocation:	/Game/Hollow/Localization/ST_World.ST_World
#: /Game/Hollow/Localization/ST_World.ST_World
msgctxt "ST_World,Class.Occultist.Description"
msgid "Reads the Aether and keeps it quiet: Resonance builds slower. The Aether lantern exposes what hunts the squad and dampens its Resonance; the ritual ward holds a doorway and calms whoever stands in it."
msgstr "Читает Эфир и не даёт ему шуметь: Резонанс растёт медленнее. Эфирный фонарь высвечивает тех, кто охотится на отряд, и гасит их Резонанс; ритуальный оберег держит проход и успокаивает всех, кто в нём стоит."

#. Key:	Class.Occultist.Name
#. SourceLocation:	/Game/Hollow/Localization/ST_World.ST_World
#: /Game/Hollow/Localization/ST_World.ST_World
msgctxt "ST_World,Class.Occultist.Name"
msgid "Techno-Occultist"
msgstr "Техно-оккультист"

