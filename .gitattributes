# Normalize text; LF in the repository and working tree for code/config (Clang and MSVC both accept LF) - ADR-0009.
* text=auto

*.h        text eol=lf
*.hpp      text eol=lf
*.inl      text eol=lf
*.cpp      text eol=lf
*.cs       text eol=lf
*.usf      text eol=lf
*.ush      text eol=lf
*.ini      text eol=lf
*.json     text eol=lf
*.uproject text eol=lf
*.uplugin  text eol=lf
*.md       text eol=lf
*.sh       text eol=lf
*.py       text eol=lf

# Windows entry points
*.bat      text eol=crlf
*.cmd      text eol=crlf
*.ps1      text eol=crlf

# Unreal binary assets
*.uasset   filter=lfs diff=lfs merge=lfs -text
*.umap     filter=lfs diff=lfs merge=lfs -text

# Source art, audio, video, fonts
